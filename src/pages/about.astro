<style>
    :global(main) {
        display: flex;
        flex-direction: row;
        justify-content: center;
        gap: 2rem;
        max-width: calc(250px + 2rem + 48rem + 2rem + 250px);
    }

    :global(main > aside) {
        flex-shrink: 0;
    }

    .spacer {
        width: 250px;
    }

    .about-content {
        max-width: 48rem;
        width: 48rem;
    }

    .tech-stack svg {
        width: 3rem;
        height: 3rem;
    }

    @media (max-width: 1440px) {
        .spacer {
            display: none;
        }
    }

    @media (max-width: 1024px) {
        :global(main) {
            flex-direction: column;
            max-width: 48rem;
        }

        .about-content {
            width: 100%;
            max-width: 100%;
        }
    }

    @media (max-width: 768px) {
        .profile-section {
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
        }

        .avatar {
            width: 100px;
            height: 100px;
        }
    }
</style>
