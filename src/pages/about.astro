---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Giscus from "@/components/Widgets/Giscus.svelte";

const [aboutEntry] = await getCollection("pages");
if (!aboutEntry) {
    throw new Error("About page not found in content collection");
}

const { Content } = await render(aboutEntry);
---

<Layout pageTitle="About" pageDescription="关于本站">
    <aside class="spacer" slot="LSide"></aside>
    <article class="about-content">
        <Content />
        <Giscus client:load />
    </article>
    <aside class="spacer" slot="RSide"></aside>
</Layout>

<style lang="scss">
    .about-content {
        max-width: 48rem;
        width: 48rem;

        :global(.welcome) {
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 2.5rem;
            font-weight: 700;
            letter-spacing: -0.03em;
            color: var(--text-color);
            padding: 2rem 0 0.5rem;
        }

        :global(.tech-stack svg) {
            width: 2.5rem;
            height: 2.5rem;
            margin-right: 0.5rem;
        }

        :global(.contact-link) {
            color: var(--link-color);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;

            &:hover {
                color: var(--link-hover-color);
                text-decoration: underline;
            }
        }
    }

    @media (max-width: 1024px) {
        .about-content {
            width: 100%;
            max-width: 100%;
        }
    }
</style>
