---
import Layout from "@/layouts/Layout.astro";
import PostPage from "@/components/PostPage.astro";
import Pagination from "@/components/Control/Pagination.astro";
import { getSortedPosts } from "@/utils/content";
import { config } from "@/config";

export async function getStaticPaths({ paginate }: any) {
    const sortedPosts = await getSortedPosts();
    return paginate(sortedPosts, { pageSize: config.page.PAGE_SIZE });
}

const { page } = Astro.props;
---

<Layout
    pageTitle={"Posts" +
        (page.currentPage > 1 ? " - Page " + page.currentPage : "")}
    pageDescription="All blog posts"
    data-pagefind-ignore
>
    <div class="page-content">
        {
            page.data.length === 0 ? (
                <p class="empty-state">
                    No posts available yet. Check back soon!
                </p>
            ) : (
                <PostPage {page} />
            )
        }
        <Pagination
            prevUrl={page.url.prev ?? undefined}
            nextUrl={page.url.next ?? undefined}
            currentPage={page.currentPage}
            totalPages={page.lastPage}
        />
    </div>
</Layout>

<style>
    :global(.page-content) {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    :global(.page-content > :first-child) {
        flex: 1;
    }

    :global(.page-content > .pagination) {
        margin-top: auto;
    }
</style>
