---
import PostCard from "@/components/PostCard.astro";

const { page } = Astro.props;

const posts = page.data;

const pinningPosts = posts.filter((post) => post.data.pin && post.data.pin > 0);

const commonPosts = posts.filter((post) => !post.data.pin);
---

<div>
    {
        pinningPosts.length > 0 && (
            <>
                <span class="pinned-header">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                    >
                        <path
                            fill="currentColor"
                            d="m21.5 9.1l-6.6-6.6l-4.2 5.6c-1.2-.1-2.4.1-3.6.7c-.1 0-.1.1-.2.1q-.75.45-1.2.9l3.7 3.7l-5.7 5.7v1.1h1.1l5.7-5.7l3.7 3.7q.6-.6.9-1.2c.1-.1.1-.2.2-.3c.6-1.1.8-2.4.6-3.6zm-7.3 3.5l.1.9c.1.9 0 1.8-.4 2.6l-6-6c.8-.4 1.7-.5 2.6-.4l.9.1L15 4.9L19.1 9z"
                        />
                    </svg>
                    <h2>置顶</h2>
                </span>
                {pinningPosts.map((post: any) => (
                    <PostCard {...post.data} id={post.id} />
                ))}
                <div class="divider" />
            </>
        )
    }

    {commonPosts.map((post: any) => <PostCard {...post.data} id={post.id} />)}

    <div class="divider"></div>
</div>

<style scoped>
    .pinned-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .pinned-header h2 {
        margin: 0;
    }

    .divider {
        border-top: 1px solid #ccc;
        margin-top: 2rem;
        margin-bottom: 2rem;
    }
</style>
