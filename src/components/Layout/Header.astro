---
import { config } from "@/config";

import Search from "./Buttons/Search.svelte";
import ThemeToggle from "./Buttons/ThemeToggle.astro";
import RSS from "./Buttons/RSS.astro";

const { SITE_TITLE } = config.site;
---

<header class="header" data-pagefind-ignore>
    <div class="container">
        <a href="/" class="site-title">{SITE_TITLE || "My Blog"}</a>
        <nav class="nav">
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/about">About</a>
                <a href="/friendlinks">Friendlinks</a>
            </div>
            <div class="nav-actions">
                <ThemeToggle />
                <Search client:only />
                <RSS />
            </div>
        </nav>
    </div>
</header>

<style scoped lang="scss">
    .header {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 0 1rem;
        border-bottom: 1px solid var(--border-color);
        background: var(--bg-color);
    }

    .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        max-width: 48rem;
        height: 3rem;
    }

    .site-title {
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        color: var(--text-color);
        letter-spacing: -0.02em;
        white-space: nowrap;

        &:hover {
            color: var(--link-color);
        }
    }

    .nav {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .nav-links {
        display: flex;
        gap: 0.15rem;

        a {
            text-decoration: none;
            color: var(--text-secondary);
            font-size: 0.875rem;
            padding: 0.35rem 0.55rem;
            border-radius: var(--radius-xs);
            transition:
                background 0.2s,
                color 0.2s;

            &:hover {
                background: var(--surface-color);
                color: var(--text-color);
            }
        }
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.15rem;
    }

    @media (max-width: 640px) {
        .container {
            height: auto;
            flex-wrap: wrap;
            padding: 0.5rem 0;
            gap: 0.5rem;
        }

        .nav {
            width: 100%;
            justify-content: space-between;
        }
    }
</style>
