            </menu>
        </div>
        <div class="footer-group">
            <hgroup class="footer-group-title">信息</hgroup>
            <menu>
                <li>
                    <a
                        href="https://github.com/XVVQAQ/XVVQAQ-Blog"
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            ><path d="M12 2L2 7l10 5 10-5-10-5Z"></path><path
