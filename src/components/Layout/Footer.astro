<style lang="scss">
    .blog-footer {
        width: 100%;
        border-top: 1px solid var(--border-color);
        padding: 2rem 1rem 1.5rem;
        transition: border-color 0.3s;
    }

    .footer-nav {
        max-width: 48rem;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        gap: 3rem;
        flex-wrap: wrap;
    }

    .footer-group {
        hgroup {
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            opacity: 0.45;
            margin-bottom: 0.5rem;
            color: var(--text-color);
        }

        menu {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        li {
            margin: 0;
            padding: 0;
        }

        a {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            color: var(--text-color);
            text-decoration: none;
            font-size: 0.85rem;
            opacity: 0.65;
            transition:
                opacity 0.2s,
                color 0.2s;

            svg {
                width: 14px;
                height: 14px;
                flex-shrink: 0;
            }

            &:hover {
                opacity: 1;
                color: var(--link-color);
            }
        }
    }

    .footer-copy {
        max-width: 48rem;
        margin: 1.5rem auto 0;
        text-align: center;
        font-size: 0.8rem;
        opacity: 0.4;
        color: var(--text-color);
        padding-top: 1rem;
        border-top: 1px solid var(--border-color);
    }

    @media (max-width: 600px) {
        .footer-nav {
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
        }

        .footer-group {
            text-align: center;

            menu {
                align-items: center;
            }
        }
    }
</style>
