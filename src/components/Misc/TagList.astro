---
import { tagLabelToSlug } from "@/utils/content";

interface Props {
    tags?: string[];
}

const { tags = [] } = Astro.props;
const uniqueTags = [...new Set(tags.filter((t) => typeof t === "string"))]
    .map((t) => t.trim())
    .filter(Boolean);
---

{
    uniqueTags.length > 0 && (
        <div class="tag-list" aria-label="Tags">
            {uniqueTags.map((tag) => (
                <a class="tag" href={`/tags/${tagLabelToSlug(tag)}`}>
                    #{tag}
                </a>
            ))}
        </div>
    )
}

<style lang="scss">
    .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0.5rem 0 0.75rem;
    }

    .tag {
        --tag-radius: var(--radius-sm);
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.5rem;
        border: 1px solid var(--border-color);
        border-radius: var(--tag-radius);
        text-decoration: none;
        color: var(--text-color);
        opacity: 0.85;
        transition:
            border-color 0.2s,
            color 0.2s,
            opacity 0.2s;
        font-size: 0.9rem;

        &:hover {
            opacity: 1;
            background: var(--border-color);
        }
    }
</style>
