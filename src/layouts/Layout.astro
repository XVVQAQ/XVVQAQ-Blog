---
import Head from "./Head.astro";
import Header from "@/components/Layout/Header.astro";
import Footer from "@/components/Layout/Footer.astro";
import "@/styles/global.scss";

interface Props {
    pageTitle: string;
    pageDescription: string;
    tags?: string[];
}

const { pageTitle, pageDescription, tags = [] } = Astro.props;
---

<!doctype html>
<html>
    <Head {pageTitle} {pageDescription} tags={tags} />
    <body>
        <Header />
        <main>
            <aside data-pagefind-ignore>
                <slot name="LSide" />
            </aside>
            <slot />
            <aside data-pagefind-ignore>
                <slot name="RSide" />
            </aside>
        </main>
        <Footer />
    </body>
</html>
